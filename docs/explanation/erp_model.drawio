        <!-- M7 — FINANCEIRO -->
        <mxCell id="m7" value="7. FINANCEIRO" style="swimlane;fontSize=13;fontStyle=1;startSize=32;fillColor=#F57F17;strokeColor=#F57F17;fontColor=#FFFFFF;swimlaneFillColor=#FFFDE7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="500" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m7obj" value="Objetivo: controlar fluxo de caixa, custos e resultado da empresa." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#F57F17;" vertex="1" parent="m7"><mxGeometry x="10" y="38" width="480" height="35" as="geometry"/></mxCell>
        <mxCell id="m7fun" value="Funcionalidades:&#xa;• Contas a pagar e a receber&#xa;• Fluxo de caixa diário / projetado&#xa;• Conciliação bancária&#xa;• Centros de custo por safra/talhão&#xa;• Controle orçamentário&#xa;• Custos de produção&#xa;• Apuração de resultado (DRE)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="m7"><mxGeometry x="10" y="75" width="480" height="140" as="geometry"/></mxCell>
        <mxCell id="m7imp" value="Impactos: confirma pagamentos, atualiza status de títulos, alimenta indicadores em Inteligência." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#B71C1C;" vertex="1" parent="m7"><mxGeometry x="10" y="220" width="480" height="60" as="geometry"/></mxCell>

        <!-- M8 — INTELIGÊNCIA -->
        <mxCell id="m8" value="8. INTELIGÊNCIA (BI &amp; ML)" style="swimlane;fontSize=13;fontStyle=1;startSize=32;fillColor=#4A148C;strokeColor=#4A148C;fontColor=#FFFFFF;swimlaneFillColor=#F3E5F5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2030" y="1020" width="500" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m8obj" value="Objetivo: prover dashboards, indicadores e projeções via ML." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#4A148C;" vertex="1" parent="m8"><mxGeometry x="10" y="38" width="480" height="35" as="geometry"/></mxCell>
        <mxCell id="m8fun" value="Funcionalidades:&#xa;• Dashboards executivos (KPIs)&#xa;• Projeção de safra (ML)&#xa;• Previsão de consumo de insumos&#xa;• Previsão de demanda e preços&#xa;• Análise de eficiência logística&#xa;• Indicadores financeiros e custos&#xa;• Data warehouse / ETL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="m8"><mxGeometry x="10" y="75" width="480" height="140" as="geometry"/></mxCell>
        <mxCell id="m8imp" value="Impactos: consome dados de todos os módulos, gera alertas estratégicos e recomendações." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#B71C1C;" vertex="1" parent="m8"><mxGeometry x="10" y="220" width="480" height="60" as="geometry"/></mxCell>

