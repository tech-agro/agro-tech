        <!-- =================================================== -->
        <!-- MÓDULOS — LINHA SUPERIOR (Produção, Estoque, Compras, Manutenção, Logística) -->
        <!-- =================================================== -->

        <!-- M1 — PRODUÇÃO AGRÍCOLA -->
        <mxCell id="m1" value="1. PRODUÇÃO AGRÍCOLA" style="swimlane;fontSize=13;fontStyle=1;startSize=32;fillColor=#1B5E20;strokeColor=#1B5E20;fontColor=#FFFFFF;swimlaneFillColor=#F1F8E9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="380" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m1obj" value="Objetivo: gerir o ciclo completo da safra e operação do campo." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#1B5E20;" vertex="1" parent="m1"><mxGeometry x="10" y="38" width="360" height="35" as="geometry"/></mxCell>
        <mxCell id="m1fun" value="Funcionalidades:&#xa;• Cadastro de safras / talhões&#xa;• Plantio, manejo e colheita&#xa;• Rastreabilidade lote → talhão&#xa;• Custos por safra/talhão&#xa;• Planejamento operacional&#xa;• Apontamento de produtividade&#xa;• Controle agronômico (pragas/clima)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="m1"><mxGeometry x="10" y="75" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="m1imp" value="Impactos: baixa insumos no Estoque, gera OS para Manutenção, alimenta Comercial e BI." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#B71C1C;" vertex="1" parent="m1"><mxGeometry x="10" y="220" width="360" height="60" as="geometry"/></mxCell>

        <!-- M2 — ESTOQUE -->
        <mxCell id="m2" value="2. ESTOQUE" style="swimlane;fontSize=13;fontStyle=1;startSize=32;fillColor=#E65100;strokeColor=#E65100;fontColor=#FFFFFF;swimlaneFillColor=#FFF3E0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="470" y="260" width="380" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m2obj" value="Objetivo: controlar insumos, sementes, defensivos e grãos colhidos." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#BF360C;" vertex="1" parent="m2"><mxGeometry x="10" y="38" width="360" height="35" as="geometry"/></mxCell>
        <mxCell id="m2fun" value="Funcionalidades:&#xa;• Entrada / saída de produtos&#xa;• Controle de saldo e lotes&#xa;• Estoque mínimo (alerta)&#xa;• Inventário e ajustes&#xa;• Movimentação entre armazéns&#xa;• Rastreamento de perdas&#xa;• Histórico de movimentações" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="m2"><mxGeometry x="10" y="75" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="m2imp" value="Impactos: atualiza saldo, dispara reposição em Compras, bloqueia venda sem saldo no Comercial." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#B71C1C;" vertex="1" parent="m2"><mxGeometry x="10" y="220" width="360" height="60" as="geometry"/></mxCell>

        <!-- M3 — COMPRAS -->
        <mxCell id="m3" value="3. COMPRAS" style="swimlane;fontSize=13;fontStyle=1;startSize=32;fillColor=#BF360C;strokeColor=#BF360C;fontColor=#FFFFFF;swimlaneFillColor=#FBE9E7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="260" width="380" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m3obj" value="Objetivo: aquisição de insumos, maquinário e gestão de fornecedores." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#BF360C;" vertex="1" parent="m3"><mxGeometry x="10" y="38" width="360" height="35" as="geometry"/></mxCell>
        <mxCell id="m3fun" value="Funcionalidades:&#xa;• Cadastro de fornecedores&#xa;• Cotação e ordem de compra&#xa;• Aprovação por alçada&#xa;• Recebimento e nota fiscal&#xa;• Conferência de pedido&#xa;• Avaliação de fornecedor&#xa;• Solicitação automática (estoque mín.)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="m3"><mxGeometry x="10" y="75" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="m3imp" value="Impactos: entrada no Estoque após recebimento, gera título a pagar no Financeiro." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#B71C1C;" vertex="1" parent="m3"><mxGeometry x="10" y="220" width="360" height="60" as="geometry"/></mxCell>

        <!-- M4 — MANUTENÇÃO -->
        <mxCell id="m4" value="4. MANUTENÇÃO" style="swimlane;fontSize=13;fontStyle=1;startSize=32;fillColor=#311B92;strokeColor=#311B92;fontColor=#FFFFFF;swimlaneFillColor=#EDE7F6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1290" y="260" width="380" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m4obj" value="Objetivo: gerir maquinário e frota agrícola, preventiva e corretiva." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#311B92;" vertex="1" parent="m4"><mxGeometry x="10" y="38" width="360" height="35" as="geometry"/></mxCell>
        <mxCell id="m4fun" value="Funcionalidades:&#xa;• Cadastro de máquinas e frota&#xa;• Ordens de serviço (OS)&#xa;• Plano de manutenção preventiva&#xa;• Histórico de manutenções&#xa;• Disponibilidade de equipamentos&#xa;• Consumo de peças e horímetro&#xa;• Indicadores (MTBF / MTTR)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="m4"><mxGeometry x="10" y="75" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="m4imp" value="Impactos: consome peças do Estoque, gera compras emergenciais, custos para o Financeiro." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#B71C1C;" vertex="1" parent="m4"><mxGeometry x="10" y="220" width="360" height="60" as="geometry"/></mxCell>

        <!-- M5 — LOGÍSTICA -->
        <mxCell id="m5" value="5. LOGÍSTICA" style="swimlane;fontSize=13;fontStyle=1;startSize=32;fillColor=#004D40;strokeColor=#004D40;fontColor=#FFFFFF;swimlaneFillColor=#E0F2F1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1700" y="260" width="380" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m5obj" value="Objetivo: distribuição e transporte da produção até o cliente." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#004D40;" vertex="1" parent="m5"><mxGeometry x="10" y="38" width="360" height="35" as="geometry"/></mxCell>
        <mxCell id="m5fun" value="Funcionalidades:&#xa;• Planejamento de rotas&#xa;• Gestão de cargas e pesagem&#xa;• Rastreamento de entregas (GPS)&#xa;• Romaneios e CT-e&#xa;• Controle de frota e motoristas&#xa;• Confirmação de entrega&#xa;• Indicadores de eficiência logística" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="m5"><mxGeometry x="10" y="75" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="m5imp" value="Impactos: baixa estoque do produto vendido, fecha pedido no Comercial, alimenta BI." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#B71C1C;" vertex="1" parent="m5"><mxGeometry x="10" y="220" width="360" height="60" as="geometry"/></mxCell>

        <!-- M6 — COMERCIAL -->
        <mxCell id="m6" value="6. COMERCIAL" style="swimlane;fontSize=13;fontStyle=1;startSize=32;fillColor=#880E4F;strokeColor=#880E4F;fontColor=#FFFFFF;swimlaneFillColor=#FCE4EC;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2150" y="260" width="380" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m6obj" value="Objetivo: gerir vendas, contratos e precificação dos grãos." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#880E4F;" vertex="1" parent="m6"><mxGeometry x="10" y="38" width="360" height="35" as="geometry"/></mxCell>
        <mxCell id="m6fun" value="Funcionalidades:&#xa;• Cadastro de clientes (CRM)&#xa;• Pedido de venda e contratos&#xa;• Tabela de preços / cotação grãos&#xa;• Política comercial e descontos&#xa;• Reserva de estoque&#xa;• Faturamento e emissão de NF&#xa;• Funil e histórico comercial" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="m6"><mxGeometry x="10" y="75" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="m6imp" value="Impactos: reserva/baixa Estoque, gera entrega na Logística, título a receber no Financeiro." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=2;fontColor=#B71C1C;" vertex="1" parent="m6"><mxGeometry x="10" y="220" width="360" height="60" as="geometry"/></mxCell>

