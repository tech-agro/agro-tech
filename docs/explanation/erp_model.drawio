        <!-- TÍTULO -->
        <mxCell id="title" value="ERP AgroTech CampoVerde — Arquitetura Modular e Integração entre Setores" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Diagnóstico organizacional transformado em arquitetura lógica de ERP — 8 módulos integrados por barramento central" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=2;fontColor=#33691E;" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="1600" height="25" as="geometry" />
        </mxCell>

        <!-- ============ CAMADA DE APRESENTAÇÃO ============ -->
