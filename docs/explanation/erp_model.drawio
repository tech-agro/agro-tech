        <mxCell id="n1-modules"  value="📁 modules/&#xa;(módulos operacionais do ERP)"      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="180" width="260" height="50" as="geometry"/></mxCell>
