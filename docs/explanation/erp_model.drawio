        <mxCell id="db-ext"    value="APIs Externas&#xa;SEFAZ • Bancos&#xa;Clima • Cotações"     style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=11;fontColor=#BF360C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2260" y="1405" width="240" height="130" as="geometry"/></mxCell>

        <!-- =================================================== -->
        <!-- REGRAS DE NEGÓCIO                                    -->
        <!-- =================================================== -->
        <mxCell id="rules" value="REGRAS DE NEGÓCIO PRINCIPAIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF6F00;strokeColor=#E65100;fontSize=14;fontStyle=1;verticalAlign=top;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="60" y="1590" width="2480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="ESTOQUE&#xa;• Não permitir saída sem saldo&#xa;• Estoque mínimo gera alerta e SC&#xa;• Inventário bloqueia movimentações&#xa;• Lote rastreável por safra/talhão" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFFFF;strokeColor=#E65100;rounded=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80"   y="1625" width="395" height="140" as="geometry"/></mxCell>
        <mxCell id="r2" value="FINANCEIRO&#xa;• Só Financeiro confirma pagamento&#xa;• Títulos vencidos mudam status auto&#xa;• Inadimplência bloqueia venda a prazo&#xa;• Centro de custo obrigatório por safra" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFFFF;strokeColor=#E65100;rounded=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="495"  y="1625" width="395" height="140" as="geometry"/></mxCell>
        <mxCell id="r3" value="PRODUÇÃO &amp; MANUTENÇÃO&#xa;• OS só finaliza após execução completa&#xa;• Peças consumidas baixam Estoque auto&#xa;• Apontamento de safra obrigatório&#xa;• Manutenção preventiva por horímetro" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFFFF;strokeColor=#E65100;rounded=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="910"  y="1625" width="395" height="140" as="geometry"/></mxCell>
        <mxCell id="r4" value="COMERCIAL &amp; LOGÍSTICA&#xa;• Pedido reserva estoque ao confirmar&#xa;• Entrega só após romaneio gerado&#xa;• Faturamento exige aprovação financeira&#xa;• Preço mínimo por política comercial" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFFFF;strokeColor=#E65100;rounded=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1325" y="1625" width="395" height="140" as="geometry"/></mxCell>
        <mxCell id="r5" value="USUÁRIOS &amp; SEGURANÇA&#xa;• Apenas gerente cancela operação&#xa;• Permissões variam por perfil (RBAC)&#xa;• Logs registram alterações críticas&#xa;• Backup diário e senha forte" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFFFF;strokeColor=#E65100;rounded=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1740" y="1625" width="395" height="140" as="geometry"/></mxCell>
        <mxCell id="r6" value="INTELIGÊNCIA (BI / ML)&#xa;• Projeções recalculadas diariamente&#xa;• Alertas estratégicos para diretoria&#xa;• Dados anonimizados para ML (LGPD)&#xa;• KPI consolidado por safra/talhão" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFFFF;strokeColor=#E65100;rounded=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2155" y="1625" width="385" height="140" as="geometry"/></mxCell>

