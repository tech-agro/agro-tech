        </mxCell>

        <!-- Exemplo concreto: estoque/ -->
        <mxCell id="ex-estoque" value="Exemplo concreto — modules/estoque/:&#xa;  ui.py              → tela de entrada/saída e inventário&#xa;  service.py         → calcula saldo, valida estoque mínimo&#xa;  repository.py      → SELECT/INSERT/UPDATE em estoque&#xa;  models.py          → Produto, Lote, Movimentacao, Armazem&#xa;  rules.py           → bloquear saída sem saldo, alerta mín.&#xa;  events.py          → publica EstoqueAbaixoMinimo, SaidaConfirmada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
