        <mxCell id="sv-doc"    value="Gestão de Documentos&#xa;(NF, contratos, CT-e)"     style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=10;fontColor=#263238;fontStyle=1;" vertex="1" parent="shared"><mxGeometry x="855" y="50" width="200" height="65" as="geometry"/></mxCell>
