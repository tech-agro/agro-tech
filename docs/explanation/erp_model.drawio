        <mxCell id="sv-int"    value="Integrações Externas&#xa;(SEFAZ, bancos, clima)"   style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=10;fontColor=#263238;fontStyle=1;" vertex="1" parent="shared"><mxGeometry x="15"  y="130" width="200" height="65" as="geometry"/></mxCell>
        <mxCell id="sv-config" value="Parâmetros &amp; Configuração&#xa;(regras de negócio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=10;fontColor=#263238;fontStyle=1;" vertex="1" parent="shared"><mxGeometry x="225" y="130" width="200" height="65" as="geometry"/></mxCell>
