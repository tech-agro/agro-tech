        <mxCell id="db-doc"    value="Storage de Arquivos&#xa;S3 / MinIO&#xa;(NF, contratos)"     style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#A5D6A7;strokeColor=#1B5E20;fontSize=11;fontColor=#1B5E20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640"  y="1405" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="db-iot"    value="Time-Series DB&#xa;InfluxDB&#xa;(IoT / sensores / clima)"   style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#A5D6A7;strokeColor=#1B5E20;fontSize=11;fontColor=#1B5E20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910"  y="1405" width="240" height="130" as="geometry"/></mxCell>
