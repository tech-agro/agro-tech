          <mxGeometry x="60" y="110" width="2480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ui-web"    value="Web App&#xa;Gestores / Diretoria"     style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90"   y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-mobile" value="App Mobile&#xa;Equipe de Campo"      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="335"  y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-portal" value="Portal Fornecedor&#xa;e Cliente"      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580"  y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-iot"    value="Coletores IoT&#xa;Sensores / Balança" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825"  y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-dash"   value="Dashboards BI&#xa;Diretoria"          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-relat"  value="Relatórios&#xa;Gerenciais"           style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1315" y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-api"    value="API REST&#xa;Integrações externas"   style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-auth"   value="Login &amp; SSO&#xa;Autenticação"     style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1805" y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-admin"  value="Console&#xa;Administrativo"          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2050" y="145" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="ui-notif"  value="Notificações&#xa;E-mail/SMS/Push"    style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#0D47A1;fontSize=11;fontColor=#0D47A1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2295" y="145" width="220" height="55" as="geometry"/></mxCell>

        <!-- ============ NÚCLEO DO ERP ============ -->
        <mxCell id="core" value="NÚCLEO ERP&#xa;AgroTech CampoVerde&#xa;━━━━━━━━━━&#xa;Barramento de Integração&#xa;Event Bus / API Gateway&#xa;Motor de Regras" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=#BF360C;fontSize=14;fontStyle=1;fontColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1060" y="760" width="480" height="220" as="geometry" />
